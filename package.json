{
  "name": "keep-sticky",
  "version": "0.1.0",
  "description": "Google Keep 연동 바탕화면 포스트잇",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test app/test/*.test.js",
    "dist": "node scripts/build.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.keepsticky.app",
    "productName": "Keep Sticky",
    "files": ["app/**/*", "package.json"],
    "extraResources": [{ "from": "dist-py/keep_service.exe", "to": "keep_service.exe" }],
    "artifactName": "KeepSticky-${env.BUILD_STAMP}.${ext}",
    "win": { "target": "portable", "icon": "google-keep-electron.ico" }
  }
}
